  "fc15d2423f80e134": [
    {
      "c": "Glosario de terminología",
      "i": 1,
      "t": "h2"
    },
    {
      "c": [
        {
          "c": [
            {
              "c": "Magnitud",
              "i": 4,
              "t": "dt"
            },
            {
              "c": "Medida del brillo de un objeto tal como se ve desde la Tierra. Los valores de magnitud más bajos indican objetos más brillantes. Las magnitudes negativas denotan los objetos más brillantes del cielo.",
              "i": 5,
              "t": "dd"
            }
          ],
          "i": 3,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Constelación",
              "i": 7,
              "t": "dt"
            },
            {
              "c": "Región definida de la esfera celeste, nombrada en honor a figuras u objetos mitológicos. Las constelaciones ayudan a localizar y catalogar objetos celestes.",
              "i": 8,
              "t": "dd"
            }
          ],
          "i": 6,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Ascensión recta",
              "i": 10,
              "t": "dt"
            },
            {
              "c": "Equivalente celeste de la longitud, medido en horas, minutos y segundos. La ascensión recta y la declinación juntas definen una posición en la esfera celeste.",
              "i": 11,
              "t": "dd"
            }
          ],
          "i": 9,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Declinación",
              "i": 13,
              "t": "dt"
            },
            {
              "c": "Equivalente celeste de la latitud, medido en grados al norte o al sur del ecuador celeste. Se usa junto con la ascensión recta para especificar posiciones.",
              "i": 14,
              "t": "dd"
            }
          ],
          "i": 12,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Clase espectral",
              "i": 16,
              "t": "dt"
            },
            {
              "c": "Clasificación de las estrellas basada en la temperatura superficial y las características espectrales. Las clases van desde O (más calientes, azules) hasta M (más frías, rojas).",
              "i": 17,
              "t": "dd"
            }
          ],
          "i": 15,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Año luz",
              "i": 19,
              "t": "dt"
            },
            {
              "c": "Distancia que recorre la luz en un año, aproximadamente 9,46 billones de kilómetros. Se usa para expresar distancias a estrellas, nebulosas y galaxias.",
              "i": 20,
              "t": "dd"
            }
          ],
          "i": 18,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Apertura",
              "i": 22,
              "t": "dt"
            },
            {
              "c": "Diámetro de la lente o el espejo principal de un telescopio. Una mayor apertura capta más luz, lo que permite observar objetos más tenues como galaxias y nebulosas distantes.",
              "i": 23,
              "t": "dd"
            }
          ],
          "i": 21,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Acimut",
              "i": 25,
              "t": "dt"
            },
            {
              "c": "Ángulo horizontal de un objeto medido en el sentido de las agujas del reloj desde el norte verdadero. Combinado con la altitud, define la posición de un objeto en el cielo local.",
              "i": 26,
              "t": "dd"
            }
          ],
          "i": 24,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Altitud",
              "i": 28,
              "t": "dt"
            },
            {
              "c": "Ángulo de un objeto celeste sobre el horizonte, medido en grados. Los objetos a mayor altitud suelen ser más fáciles de observar debido a una menor interferencia atmosférica.",
              "i": 29,
              "t": "dd"
            }
          ],
          "i": 27,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "Época",
              "i": 31,
              "t": "dt"
            },
            {
              "c": "Punto de referencia en el tiempo utilizado para coordenadas celestes. La época estándar actual es J2000.0, que corresponde al 1 de enero de 2000.",
              "i": 32,
              "t": "dd"
            }
          ],
          "i": 30,
          "t": "div"
        }
      ],
      "i": 2,
      "t": "dl"
    }
  ],
  "fcb1772fe9bf1d0e": "Stellaris Observatory — El cielo de esta noche"
}