  "eab13eebca1ec566": [
    {
      "c": "Guía del observador",
      "i": 1,
      "t": "h1"
    },
    {
      "c": "Una guía de referencia que abarca tipos de objetos celestes, equipo recomendado, niveles de dificultad y terminología astronómica esencial. Tanto si eres principiante y estás aprendiendo a identificar constelaciones como si eres un observador avanzado en busca de galaxias tenues, esta guía cubre los fundamentos.",
      "i": 2,
      "t": "p"
    }
  ],
  "f1eca71a4c69c633": [
    {
      "c": "Catálogo de objetos",
      "i": 1,
      "t": "h1"
    },
    {
      "c": "Un catálogo completo de objetos celestes visibles desde el Stellaris Observatory. Filtra por tipo de objeto, constelación o rango de magnitud. Cada entrada incluye datos de clase espectral, distancia en años luz y coordenadas en ascensión recta y declinación.",
      "i": 2,
      "t": "p"
    }
