  "fc15d2423f80e134": [
    {
      "c": "用語集",
      "i": 1,
      "t": "h2"
    },
    {
      "c": [
        {
          "c": [
            {
              "c": "等級",
              "i": 4,
              "t": "dt"
            },
            {
              "c": "地球から見た天体の明るさを表す尺度です。数値が小さいほど明るい天体を意味します。負の等級は、空で最も明るい天体を示します。",
              "i": 5,
              "t": "dd"
            }
          ],
          "i": 3,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "星座",
              "i": 7,
              "t": "dt"
            },
            {
              "c": "神話上の人物や物体の名が付けられた、天球上で定義された領域です。星座は天体の位置特定やカタログ作成に利用されます。",
              "i": 8,
              "t": "dd"
            }
          ],
          "i": 6,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "赤経",
              "i": 10,
              "t": "dt"
            },
            {
              "c": "天球上の経度に相当する量で、時・分・秒で表されます。赤経と赤緯を組み合わせて、天球上の位置を定義します。",
              "i": 11,
              "t": "dd"
            }
          ],
          "i": 9,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "赤緯",
              "i": 13,
              "t": "dt"
            },
            {
              "c": "天球上の緯度に相当する量で、天の赤道から北または南への角度を度数で表します。赤経と組み合わせて天体の位置を指定します。",
              "i": 14,
              "t": "dd"
            }
          ],
          "i": 12,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "スペクトル型",
              "i": 16,
              "t": "dt"
            },
            {
              "c": "表面温度とスペクトルの特徴に基づく恒星の分類です。型は O（最も高温で青色）から M（最も低温で赤色）までの範囲があります。",
              "i": 17,
              "t": "dd"
            }
          ],
          "i": 15,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "光年",
              "i": 19,
              "t": "dt"
            },
            {
              "c": "光が 1 年間に進む距離で、およそ 9.46 兆キロメートルです。恒星、星雲、銀河までの距離を表すのに用いられます。",
              "i": 20,
              "t": "dd"
            }
          ],
          "i": 18,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "口径",
              "i": 22,
              "t": "dt"
            },
            {
              "c": "望遠鏡の主レンズまたは主鏡の直径です。口径が大きいほど多くの光を集められ、遠方の銀河や星雲のような暗い天体を観測しやすくなります。",
              "i": 23,
              "t": "dd"
            }
          ],
          "i": 21,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "方位角",
              "i": 25,
              "t": "dt"
            },
            {
              "c": "真北から時計回りに測った天体の水平方向の角度です。高度と組み合わせて、局地的な空における天体の位置を表します。",
              "i": 26,
              "t": "dd"
            }
          ],
          "i": 24,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "高度",
              "i": 28,
              "t": "dt"
            },
            {
              "c": "天体の地平線からの高さを度数で表した角度です。高度が高い天体は、一般に大気の影響が少ないため観測しやすくなります。",
              "i": 29,
              "t": "dd"
            }
          ],
          "i": 27,
          "t": "div"
        },
        {
          "c": [
            {
              "c": "エポック",
              "i": 31,
              "t": "dt"
            },
            {
              "c": "天体座標の基準となる時刻です。現在の標準エポックは J2000.0 で、2000 年 1 月 1 日に相当します。",
              "i": 32,
              "t": "dd"
            }
          ],
          "i": 30,
          "t": "div"
        }
      ],
      "i": 2,
      "t": "dl"
    }
  ],
  "fcb1772fe9bf1d0e": "Stellaris Observatory — 今夜の星空"
}