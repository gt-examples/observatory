  "eab13eebca1ec566": [
    {
      "c": "観測ガイド",
      "i": 1,
      "t": "h1"
    },
    {
      "c": "天体の種類、推奨機材、難易度、主要な天文学用語をまとめたリファレンスガイドです。星座の見分け方を学ぶ初心者から、淡い銀河を探す上級観測者まで、基本的な内容を一通りカバーします。",
      "i": 2,
      "t": "p"
    }
  ],
  "f1eca71a4c69c633": [
    {
      "c": "天体カタログ",
      "i": 1,
      "t": "h1"
    },
    {
      "c": "Stellaris Observatory から観測可能な天体のカタログです。天体の種類、星座、または等級範囲で絞り込むことができます。各エントリには、スペクトル型データ、光年単位での距離、および赤経・赤緯で表される座標が含まれます。",
      "i": 2,
      "t": "p"
    }
  ],
