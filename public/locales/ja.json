  "2eab296242fa4f4c": [
    {
      "c": "観測ログ",
      "i": 1,
      "t": "h1"
    },
    {
      "c": "Stellaris Observatory における観測セッションを時系列で記録したログです。各エントリには、観測対象、気象・シーイング条件、使用機材、および品質評価が記録されます。任意のエントリをクリックすると、詳細なノートが表示されます。",
      "i": 2,
      "t": "p"
    }
  ],
  "39e136d22ecaae05": [
